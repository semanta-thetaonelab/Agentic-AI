# Copy to .env and fill in real values:  cp .env.example .env

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-flash
TEMPERATURE=0.2

# --- Voice loop (all optional, defaults shown) ---

# Seconds of silence before a spoken turn is sent for transcription.
# Speech that resumes inside this window is merged into the same turn.
STT_SILENCE_MS=5000

# Local whisper.cpp binary and model. Requires: brew install whisper-cpp
WHISPER_BIN=whisper-cli
WHISPER_MODEL=./models/ggml-base.en.bin

# Text-to-speech. Leave SAY_VOICE blank for the system default voice.
# List installed voices with: say -v '?'
SAY_VOICE=
SAY_SPEED=1.0

# RMS level (0-1) below which audio never counts as speech, however quiet the
# room. Raise it if background noise keeps cutting turns short.
STT_MIN_RMS=0.012
